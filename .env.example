# Скопируйте в .env. Настоящий .env с ключами нельзя коммитить или отправлять в чат.

# OpenRouter: основная модель для чата, гипотез и разбора документов.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash # openai/gpt-4.1
# Отдельная модель для веб-исследования проектов (функция Research); пустое значение в Compose
# автоматически заменяется значением OPENROUTER_MODEL.
OPENROUTER_RESEARCH_MODEL=deepseek/deepseek-v4.1-flash # openai/gpt-4.1
# Повтор временной ошибки OpenRouter: ограничиваем одной попыткой, чтобы экономить общий бюджет поиска.
OPENROUTER_MAX_RETRIES=1
# Таймаут одного запроса радара к OpenRouter, в секундах.
OPENROUTER_TIMEOUT=90
# Включает извлечение графа/связей из документов; относится к модулю анализа документов.
OPENROUTER_GRAPH_EXTRACTION=true
# Максимум источников для функции Research в старом модуле анализа проектов (1–12).
OPENROUTER_RESEARCH_MAX_SOURCES=8
# Качество/детализация передаваемых OpenRouter изображений: low, high или auto.
OPENROUTER_VISION_DETAIL=high

# База данных радара. Локально пустое значение включает SQLite в storage/radar.db;
# Docker Compose сам задаёт PostgreSQL, поэтому обычно здесь менять нечего.
RADAR_DATABASE_URL=
# Максимум веток всего: обязательный исходный запрос + дополнительные направления LLM (1–8).
RADAR_SEARCH_BRANCHES=4
# Максимум найденных источников-кандидатов на чтение (8–128). Широкое покрытие важнее ранней отсечки.
RADAR_MAX_SOURCES=110
# Верхняя граница кандидатов на проверку и логрег (15–64); финальная выдача ранжирует до 15.
RADAR_MAX_CANDIDATES=60
# Число одновременных задач поиска/чтения внутри одного поискового запуска (1–4).
RADAR_SEARCH_WORKERS=3
# Максимум параллельно выполняемых поисков сервиса (1–3).
RADAR_MAX_ACTIVE_RUNS=1
# Бюджет поиска: облачный профиль целится в 18 минут; код ограничит его 20 минутами. Локальный режим — до 3600 сек.
RADAR_DEADLINE_SECONDS=1080
# Таймаут загрузки одной страницы-источника, в секундах (3–30).
RADAR_FETCH_TIMEOUT=12
# Необязательный OpenAI-compatible endpoint /v1/audio/transcriptions для локального ASR.
# По умолчанию отключён; например, можно указать свой Whisper-сервис.
RADAR_AUDIO_TRANSCRIPTION_URL=
RADAR_AUDIO_TRANSCRIPTION_TOKEN=
RADAR_AUDIO_TRANSCRIPTION_MODEL=whisper-1
# Явный список доменов с разрешёнными аудиозаписями для ASR, через запятую.
# Не добавляйте youtube.com: аудио YouTube не скачивается этим сервисом.
RADAR_AUDIO_TRANSCRIPTION_ALLOWLIST=
# Таймаут ASR (15–600 сек.) и предел аудиофайла (1–25 МБ).
RADAR_AUDIO_TRANSCRIPTION_TIMEOUT=180
RADAR_AUDIO_TRANSCRIPTION_MAX_MB=20
# Сколько часов хранить кэш ответов источников; 0 отключает использование свежего кэша.
RADAR_CACHE_HOURS=24
# Адрес, на котором Docker публикует веб-интерфейс. 127.0.0.1 доступен только с этого компьютера.
RADAR_HOST=127.0.0.1
# Порт веб-интерфейса на компьютере-хосте.
RADAR_PORT=8080

# Обязательный API-ключ OpenRouter для функций на базе LLM и извлечения признаков.
OPENROUTER_API_KEY=

# Патенты через FreePatentsOnline; 0 отключает патентный поиск и признаки патентов.
FEATURE_PATENTS=1

# Прямые структурированные источники: OpenAlex, гранты, GitHub/Hugging Face, TED и медицина.
# 1 — включены; 0 — отключены. Многие работают без ключа, необязательные ключи ниже повышают лимиты.
FEATURE_STRUCTURED_SOURCES=1
# По умолчанию OpenAlex отключён из-за частых 429. Значение 1 включает его поиск и резерв arXiv.
OPENALEX_ENABLED=0
# Необязательный ключ OpenAlex, учитывается только при OPENALEX_ENABLED=1.
OPENALEX_API_KEY=
# Необязательный GitHub token для более высокого лимита запросов к GitHub API.
GITHUB_TOKEN=
# Необязательный Hugging Face token для более высокого лимита/доступа к API.
HF_TOKEN=
# Необязательный ключ openFDA для более высокого лимита медицинского API.
OPENFDA_API_KEY=
# Контактный email в запросах к Crossref/OpenAlex по их правилам вежливого доступа.
OPENALEX_MAILTO=roflpocht@yandex.ru
# LLM разметки признаков (события, стадия, «технология или нет»); модель скоринга обучена на её
# разметке. Сравнение моделей — docs/10-model-comparison.md.
FEATURE_MODEL=openai/gpt-5.6-luna
# Таймаут одного запроса извлечения признаков и число попыток (15–600 сек., 1–2).
# Облачный режим по умолчанию использует 60 сек. и одну попытку, чтобы не блокировать поиск;
# для локальной медленной модели можно увеличить, например, до 300–600 сек. и двух попыток.
FEATURE_LLM_TIMEOUT=60
FEATURE_LLM_TRIES=1
# Таймаут и число попыток для запросов источников при сборе признаков (5–90 сек., 1–4).
# По умолчанию 20 сек. и 2 попытки; после HTTP 429 OpenAlex повторные запросы временно пропускаются.
FEATURE_FETCH_TIMEOUT=20
FEATURE_FETCH_TRIES=2
# Провайдер LLM радара: openrouter — облачная модель через OpenRouter;
# local — открытая модель на своём OpenAI-совместимом сервере (Ollama, vLLM, SGLang, LM Studio).
RADAR_PROVIDER=openrouter
# Для RADAR_PROVIDER=local: радар и разметка признаков идут на этот сервер, веб-поиск — сервис
# поиска ниже, модель скоринга — app/ml/model/logreg_v1_<LOCAL_MODEL>.json.
# Из списка ТЗ локально: qwen3.6:35b-a3b (быстрее); лучшее качество — qwen3.8:27b
# (не из списка, см. docs/10-model-comparison.md). В Docker: http://host.docker.internal:11434/v1
# Разметку признаков можно вынести отдельно от поиска (облачный поиск + локальная разметка и наоборот):
# FEATURE_MODEL=qwen3.6:35b-a3b и FEATURE_LLM_URL=http://localhost:11434/v1. Модель скоринга
# выбирается по LLM разметки автоматически (SIGNAL_MODEL_PATH — явно).
# Сервер: Ollama — http://localhost:11434/v1; vLLM — http://localhost:8000/v1; SGLang — http://localhost:30000/v1.
LOCAL_LLM_URL=http://localhost:11434/v1
# Как у сервера выключаются рассуждения: ollama | vllm | sglang | openai-compatible (без спец. полей).
LOCAL_LLM_BACKEND=ollama
# Имя модели на сервере: Ollama — qwen3.6:35b-a3b; vLLM/SGLang — HF-id, например Qwen/Qwen3.6-35B-A3B.
LOCAL_MODEL=qwen3.6:35b-a3b
LOCAL_LLM_KEY=
# JSON с доп. полями запроса вместо значений по LOCAL_LLM_BACKEND (обычно не нужен).
LOCAL_LLM_EXTRA=
LOCAL_TIMEOUT=600

# ---- Веб-поиск (сервис app/search, docs/11-search.md)
# service — сервис поиска (провайдеры ниже); llm — веб-плагин OpenRouter как раньше; off — без веб-поиска.
RADAR_WEB_SEARCH=service
# Провайдеры через запятую — цепочка: при ошибке или пустой выдаче работает следующий.
# searxng | tavily | exa | brave | yandex | openserp | openrouter. По умолчанию searxng (без ключей).
SEARCH_PROVIDERS=searxng
# fallback — первый ответивший провайдер; fanout — все сразу, выдача объединяется.
SEARCH_MODE=fallback
# Адрес сервиса поиска. В Docker Compose задан автоматически (http://search:8090);
# пусто — поиск выполняется в процессе радара тем же кодом.
SEARCH_URL=
# Необязательный токен сервиса поиска (заголовок X-Search-Token).
SEARCH_SERVICE_TOKEN=
SEARCH_TIMEOUT=20
SEARCH_CACHE_HOURS=24
# SearXNG: в Compose — свой контейнер; вне Docker — адрес своего инстанса (публичные закрывают JSON API).
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=
# Движки SearXNG. С одного IP Brave и Google CSE быстро упираются в лимиты, DuckDuckGo и Qwant —
# в капчу; Yahoo, Bing News и Google News держатся.
SEARXNG_ENGINES=yahoo,bing news,google news,brave,google cse,duckduckgo
# Обычный лимит метапоиска на одну задачу: русский, английский и один следующий язык.
# Широкий первый проход по исходной теме отдельно ищет по всем 14 приоритетным локалям,
# с малой выдачей на язык; уточняющие ветки остаются в пределах этого лимита.
SEARCH_MAX_QUERIES=3
# Пауза между запросами к своему SearXNG/OpenSERP, секунды.
SEARCH_MIN_INTERVAL=1.0
# Ключи платных провайдеров — только для выбранных в SEARCH_PROVIDERS.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# OpenSERP — свой инстанс (docker compose --profile openserp up); движки для /mega/search.
OPENSERP_URL=http://localhost:7000
OPENSERP_ENGINES=bing,duckduckgo,yandex
# Модель для провайдера openrouter (веб-плагин: LLM ищет и цитирует ссылки).
SEARCH_OPENROUTER_MODEL=openai/gpt-4.1
# 1 — оценивать кандидатов обученной логистической регрессией; 0 — использовать фиксированную рубрику.
RADAR_USE_MODEL=1
# 1 — включить прямые поисковые коннекторы (Bing News, Crossref, патенты, OpenAlex и другие);
# 0 — оставить только веб-поиск (RADAR_WEB_SEARCH).
RADAR_OPEN_SOURCES=1
