# IDEA / технологический радар
# Скопируйте файл в .env. Не добавляйте .env с ключами в git и не отправляйте его в чат.

# ── 1. Адрес сайта и хранение данных ─────────────────────────────────────────
# Адрес и порт веб-интерфейса на компьютере-хосте. 127.0.0.1 доступен только локально.
RADAR_HOST=127.0.0.1
RADAR_PORT=8080
# База данных радара. Пустое значение включает SQLite в storage/radar.db;
# Docker Compose задаёт PostgreSQL самостоятельно.
RADAR_DATABASE_URL=
# Время хранения кэша поисковых ответов, часы. 0 отключает свежий кэш.
RADAR_CACHE_HOURS=24

# ── 2. Ограничения и параллельность поиска ───────────────────────────────────
# Общее число направлений: исходная тема плюс уточнения (1–16). 8 — широкий режим.
RADAR_SEARCH_BRANCHES=8
# Максимум ссылок для чтения и проверки (8–512). Фактический охват зависит от выдачи поисковиков.
RADAR_MAX_SOURCES=256
# Максимум кандидатов для проверки и скоринга (15–128); в ТОП попадает до 15.
RADAR_MAX_CANDIDATES=80
# Параллельные задачи поиска/чтения (1–8). Большие значения могут вызвать лимиты поисковиков.
RADAR_SEARCH_WORKERS=4
# Параллельное извлечение признаков логистической регрессии (1–12).
RADAR_MODEL_WORKERS=8
# Максимум параллельно выполняемых исследований сервиса (1–3).
RADAR_MAX_ACTIVE_RUNS=1
# Бюджет исследования в секундах. Облачный режим ограничен 20 минутами;
# локальный режим допускает до часа. 1080 оставляет резерв на завершение.
RADAR_DEADLINE_SECONDS=1080
# Таймаут загрузки одной страницы-источника, секунды (3–30).
RADAR_FETCH_TIMEOUT=12
# Мягкий резерв сверх основного лимита чтения под гранты, контракты и венчур (0–0.6).
RADAR_MONEY_MIN_SHARE=0.3
# Сколько первых направлений запроса опрашивают денежные коннекторы (0–16).
RADAR_MONEY_BRANCHES=6

# ── 3. LLM и скоринг ─────────────────────────────────────────────────────────
# Провайдер модели радара: openrouter или local.
RADAR_PROVIDER=openrouter
# OpenRouter используется для облачных LLM-вызовов и старого раздела /lab.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Отдельная LLM-роль поиска/Research. В Docker пустое значение заменяется основной моделью.
OPENROUTER_RESEARCH_MODEL=deepseek/deepseek-v4.1-flash-1017
# Таймаут облачного LLM-вызова, секунды (10–180).
OPENROUTER_TIMEOUT=90
# Повтор временной ошибки OpenRouter (0–2).
OPENROUTER_MAX_RETRIES=1
# Модели OpenRouter вне встроенного списка, через запятую (vendor/model).
RADAR_EXTRA_MODELS=
# Глубина рассуждений: пусто — настройка модели; none/minimal/low/medium/high.
RADAR_REASONING_EFFORT=
# Переопределение по ролям: список role:effort через запятую, например web_search:none.
RADAR_REASONING_BY_ROLE=web_search:none
# Использовать обученную логистическую регрессию (1) или фиксированную рубрику (0).
RADAR_USE_MODEL=1

# LLM-модель для извлечения признаков. Для локального скоринга укажите имя модели,
# для которой есть совместимый артефакт; см. docs/10-model-configuration.md.
FEATURE_MODEL=openai/gpt-5.6-luna
# Таймаут одного запроса признаков (15–600 секунд) и число попыток (1–2).
FEATURE_LLM_TIMEOUT=60
FEATURE_LLM_TRIES=1
# Таймаут запроса к источнику при сборе признаков (5–90 секунд) и число попыток (1–4).
FEATURE_FETCH_TIMEOUT=20
FEATURE_FETCH_TRIES=2
# Сколько секунд ждать денежные источники при проверке кандидата.
FEATURE_MONEY_SEARCH_SECONDS=45

# ── 4. Локальная LLM (только при RADAR_PROVIDER=local) ───────────────────────
# OpenAI-совместимый сервер. В Docker Compose для Ollama на хосте используйте этот адрес;
# при запуске Uvicorn напрямую обычно подходит http://localhost:11434/v1.
LOCAL_LLM_URL=http://host.docker.internal:11434/v1
# Сервер: ollama, vllm, sglang или openai-compatible.
LOCAL_LLM_BACKEND=ollama
# Имя модели на сервере: Ollama — qwen3.6:35b-a3b; vLLM/SGLang — HF-id.
LOCAL_MODEL=qwen3.6:35b-a3b
LOCAL_LLM_KEY=
# Дополнительные поля JSON для OpenAI-совместимого API; обычно не требуется.
LOCAL_LLM_EXTRA=
# Таймаут локальной модели, секунды (30–1800).
LOCAL_TIMEOUT=600

# ── 5. Веб-поиск ─────────────────────────────────────────────────────────────
# service — отдельный поисковый сервис; llm — OpenRouter web search; off — отключить.
RADAR_WEB_SEARCH=service
# Провайдеры в порядке fallback либо одновременно в режиме fanout.
# Варианты: searxng, tavily, exa, brave, yandex, openserp, openrouter.
SEARCH_PROVIDERS=searxng
SEARCH_MODE=fallback
# В Docker Compose адрес задаётся автоматически; пустое значение использует код поиска внутри радара.
SEARCH_URL=
SEARCH_SERVICE_TOKEN=
SEARCH_TIMEOUT=20
SEARCH_CACHE_HOURS=24
# Число языковых поисковых формулировок в каждом уточнении (3–15; RU, EN и язык запроса включены).
# Исходная тема дополнительно проходит по всем подготовленным локалям.
SEARCH_MAX_QUERIES=6
# Сколько результатов просить у поисковика на каждую формулировку (1–20; провайдер может вернуть меньше).
SEARCH_RESULTS_PER_QUERY=5
# Пауза между запросами к SearXNG/OpenSERP, секунды.
SEARCH_MIN_INTERVAL=1.0
# SearXNG: в Docker Compose адрес задаёт compose (http://searxng:8080), строку не раскомментируйте:
# значение из .env заменит его, и поиск внутри контейнера не найдёт SearXNG.
# Вне Docker без этой строки используется тот же адрес; раскомментируйте, если инстанс другой.
# SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=
# Движки SearXNG через запятую. Доступность зависит от лимитов поисковых систем и сети.
SEARXNG_ENGINES=yahoo,bing news,google news,brave,google cse,duckduckgo
# Ключи нужны только выбранным платным провайдерам.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# OpenSERP: собственный сервис, запускается профилем docker compose --profile openserp.
# В Compose адрес задаёт compose (http://openserp:7000); вне Docker адрес ниже — значение по умолчанию.
# OPENSERP_URL=http://localhost:7000
OPENSERP_ENGINES=bing,duckduckgo,yandex
# Используется только при SEARCH_PROVIDERS=openrouter.
SEARCH_OPENROUTER_MODEL=openai/gpt-4.1

# ── 6. Прямые каналы и коннекторы ────────────────────────────────────────────
# Включить прямые открытые коннекторы радара (1) или оставить только веб-поиск (0).
RADAR_OPEN_SOURCES=1
# Дополнительные коннекторы: all или список имён через запятую; доступность также зависит от ключей.
RADAR_EXTRA_CONNECTORS=all
# Принудительно отключить коннекторы даже при RADAR_EXTRA_CONNECTORS=all.
RADAR_DISABLED_CONNECTORS=
# Структурированные API для исследовательских признаков: 1 — включены, 0 — выключены.
FEATURE_STRUCTURED_SOURCES=1
# Старое количественное обогащение FPO для схем признаков; активный артефакт может его не использовать.
FEATURE_PATENTS=1
# OpenAlex по умолчанию выключен из-за частых HTTP 429; 1 включает его и резерв arXiv.
OPENALEX_ENABLED=0
OPENALEX_API_KEY=
# Контакт для вежливых запросов к OpenAlex/Crossref; не является ключом.
OPENALEX_MAILTO=roflpocht@yandex.ru
# Необязательные ключи для увеличения лимита доступа к отдельным API.
GITHUB_TOKEN=
HF_TOKEN=
OPENFDA_API_KEY=
# Контактный email для SEC EDGAR и вежливых пулов; имеет приоритет над OPENALEX_MAILTO.
CONTACT_EMAIL=
# EPO Open Patent Services; без ключей патентный коннектор пропускает этот источник.
EPO_OPS_KEY=
EPO_OPS_SECRET=
# API поисковой платформы Роспатента; без ключа соответствующий коннектор выключен.
ROSPATENT_API_KEY=

# ── 7. Расшифровка аудио (необязательно) ─────────────────────────────────────
# OpenAI-compatible endpoint /v1/audio/transcriptions; пустое значение отключает ASR.
RADAR_AUDIO_TRANSCRIPTION_URL=
RADAR_AUDIO_TRANSCRIPTION_TOKEN=
RADAR_AUDIO_TRANSCRIPTION_MODEL=whisper-1
# Разрешённые домены с аудиозаписями, через запятую. YouTube-аудио не скачивается.
RADAR_AUDIO_TRANSCRIPTION_ALLOWLIST=
# Таймаут ASR (15–600 секунд) и максимальный размер аудио (1–25 МБ).
RADAR_AUDIO_TRANSCRIPTION_TIMEOUT=180
RADAR_AUDIO_TRANSCRIPTION_MAX_MB=20

# ── 8. Старый модуль /lab ────────────────────────────────────────────────────
# Извлечение графа знаний из документов и материалов в /lab.
OPENROUTER_GRAPH_EXTRACTION=true
# Максимум источников для функции Research в /lab (1–12).
OPENROUTER_RESEARCH_MAX_SOURCES=8
# Детализация изображений для анализа документов: low, high или auto.
OPENROUTER_VISION_DETAIL=high
