    "science_news":    {"label": "Научно-популярное издание", "trust": "high", "primary_only": false, "reason": "Пересказ научных работ; первичный источник — сама работа."},
    "publication":     {"label": "Научная публикация", "trust": "high", "primary_only": false, "reason": "Рецензируемый издатель; применимость результата проверяется отдельно."},
    "open_access":     {"label": "Научный журнал открытого доступа", "trust": "medium", "primary_only": false, "reason": "Рецензирование есть, строгость различается между журналами."},
    "preprint":        {"label": "Препринт", "trust": "medium", "primary_only": false, "reason": "Научная работа без рецензирования."},
    "institution":     {"label": "Институциональный источник", "trust": "high", "primary_only": false, "reason": "Регулятор, госорган, международная организация или университет."},
    "standards_body":  {"label": "Орган стандартизации", "trust": "high", "primary_only": false, "reason": "Официальные стандарты и проекты стандартов."},
    "patent":          {"label": "Патентный источник", "trust": "medium", "primary_only": false, "reason": "Патент подтверждает заявку на изобретение, но не работоспособность и не внедрение."},
    "tech_community":  {"label": "Техническое сообщество", "trust": "medium", "primary_only": false, "reason": "Публикации специалистов и компаний без редакционной проверки."},
    "press_release":   {"label": "Пресс-релиз", "trust": "low", "primary_only": false, "reason": "Заявление заинтересованной стороны; не может быть единственным подтверждением."},
    "social":          {"label": "Социальная сеть", "trust": "low", "primary_only": true, "reason": "Только первичный индикатор (ТЗ): требуется подтверждение независимым источником."},
    "blog":            {"label": "Блог-платформа", "trust": "low", "primary_only": true, "reason": "Только первичный индикатор (ТЗ): пользовательский контент без редакции."},
    "aggregator":      {"label": "Агрегатор", "trust": "low", "primary_only": true, "reason": "Только первичный индикатор (ТЗ): перепубликация чужих материалов."},
    "website":         {"label": "Веб-источник", "trust": "unverified", "primary_only": false, "reason": "Домена нет в реестре: тип и независимость издателя не установлены."}
