@startuml context
title IDEA Radar — текущая архитектура
skinparam componentStyle rectangle
skinparam defaultFontName Arial
left to right direction

actor "Пользователь" as user

package "Интерфейс" {
  [React SPA\nпоиск · ТОП-15 · карточки · графики] as ui
}

package "Приложение FastAPI\n(app/main.py)" {
  [API радара] as api
  [Оркестратор запуска] as pipeline
  [Коннекторы и загрузчик] as connectors
  [Извлечение кандидатов\nи проверка цитат] as evidence
  [Признаки + logreg_v1\n46 входов] as model
  [Сборка выдачи\nи годовой диаграммы] as output
}

package "Поисковый сервис (Compose)" {
  [app/search] as search
  [SearXNG] as searx
}

database "RadarStore\nPostgreSQL / локальный SQLite\nradar_runs + radar_sources" as store
cloud "Открытые источники\nCrossref · новости · гранты ·\nпатенты · закупки · другие API" as sources
cloud "OpenRouter или локальная\nOpenAI-compatible LLM" as llm

package "Старый раздел /lab" {
  [Hypothesis Lab API] as lab
  database "Отдельная SQLite база" as labdb
}

user --> ui
ui --> api : HTTP, polling
api --> pipeline
pipeline --> search
search --> searx
search --> sources
pipeline --> connectors
connectors --> sources
pipeline --> evidence
evidence --> llm
pipeline --> model
model --> sources : API-свидетельства
model --> llm : извлечение признаков
pipeline --> output
output --> store
api --> store
user --> lab : /lab
lab --> labdb
@enduml
