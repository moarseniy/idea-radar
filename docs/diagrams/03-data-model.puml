@startuml data_model
title Хранение радарных запусков и источников
skinparam defaultFontName Arial
hide circle
skinparam linetype ortho

entity radar_runs {
  * id : text
  --
  created_at : text
  updated_at : text
  status : text
  payload : JSONB / JSON text
}

entity radar_sources {
  * run_id : text <<FK>>
  * id : text
  --
  payload : JSONB / JSON text
}

radar_runs ||--o{ radar_sources : owns

note right of radar_runs
  Payload содержит запрос, прогресс,
  кандидатов, оценки, вердикты,
  метрики и визуализации.
  Запись источника хранит extracted text,
  URL, дату и статус обработки.
end note

note bottom of radar_sources
  Compose: PostgreSQL JSONB.
  Локально без RADAR_DATABASE_URL:
  SQLite storage/radar.db.
  Исходные байты HTTP отдельно не хранятся.
end note

package "Отдельный старый раздел /lab" {
  entity projects {
    * id : text
    --
    name : text
    goal, constraints, domain
    settings_json : text
  }
  entity documents {
    * id : text
    --
    project_id : text
    extracted_text : text
    meta_json : text
    path : text
  }
  entity hypotheses {
    * id : text
    --
    project_id : text
    title, statement, status
    evidence_json : text
    version_no : integer
  }
  entity knowledge_nodes {
    * project_id, node_id
    --
    label, type, summary
    source_ids_json : text
  }
  entity knowledge_edges {
    * project_id, edge_id
    --
    source, target, relation
    evidence : text
    source_ids_json : text
  }
  projects ||--o{ documents
  projects ||--o{ hypotheses
  projects ||--o{ knowledge_nodes
  projects ||--o{ knowledge_edges
}
@enduml
